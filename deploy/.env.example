# Copy to .env next to docker-compose.yml and fill in.

# Domain of the site. Without your own domain sslip.io points at the server IP:
# 168-113-177-166.sslip.io. Caddy gets the HTTPS certificate for it on its own.
SITE_ADDRESS=168-113-177-166.sslip.io

# Generate both with: openssl rand -hex 32
DB_PASSWORD=
JWT_SECRET=

# Real mail for registration codes, e.g. mail.ru with an app password.
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=

# Image tag to run: latest, or a commit sha to roll back.
BITO_TAG=latest
