# Server
SERVER_PORT=8080
SERVER_ENV=development

# PostgreSQL (docker compose publishes it on 5433)
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=1221
DB_NAME=bito_db
DB_SSLMODE=disable

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# SMTP / Mailpit (web UI on http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@bito.local

# JWT (production refuses a secret shorter than 32 bytes)
JWT_SECRET=change-me-to-a-random-string-of-32-bytes
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# Allowed origins for the browser and websockets (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
