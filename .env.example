# Server
SERVER_PORT=8080
SERVER_ENV=development

# PostgreSQL (docker compose publishes it on 5433)
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=1221
DB_NAME=bito_db
DB_SSLMODE=disable

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# SMTP. Left commented, letters land in Mailpit (web UI on http://localhost:8025)
# both for `make run` and for the server in docker compose.
# For real mail use your provider and an app password, e.g. mail.ru:
#   SMTP_HOST=smtp.mail.ru  SMTP_PORT=465  SMTP_USER=you@mail.ru  SMTP_FROM=you@mail.ru
# Port 465 uses TLS from the start, 587 upgrades with STARTTLS.
# SMTP_HOST=
# SMTP_PORT=
# SMTP_FROM=
# SMTP_USER=
# SMTP_PASSWORD=

# JWT (production refuses a secret shorter than 32 bytes)
JWT_SECRET=change-me-to-a-random-string-of-32-bytes
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# Allowed origins for the browser and websockets (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
